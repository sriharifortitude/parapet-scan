{
  "name": "bastion-scan",
  "version": "0.1.0",
  "description": "Audits the externally observable security posture of a web application: headers, TLS, cookies, CORS, information disclosure and content integrity.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "bastion": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "lab:up": "docker compose -f lab/docker-compose.yml up -d --wait",
    "lab:down": "docker compose -f lab/docker-compose.yml down -v"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "node-html-parser": "^6.1.13",
    "picocolors": "^1.1.1",
    "undici": "^6.21.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "license": "MIT"
}
